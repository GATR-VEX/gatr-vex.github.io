# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=

# Public site URL (local: http://localhost:3000, prod: https://your-app.vercel.app)
AUTH_URL=http://localhost:3000

# Google OAuth (https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI: {AUTH_URL}/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Comma-separated Google account emails allowed into /members
# (merged with defaults in lib/members.ts)
AUTH_MEMBER_EMAILS=

# Vercel Blob — required on Vercel so the print queue persists across deploys.
# Create a Blob store in the Vercel project; the token is injected automatically
# when linked, or set BLOB_READ_WRITE_TOKEN manually.
# Locally, leave unset to use data/ + public/uploads/prints/ on disk.
BLOB_READ_WRITE_TOKEN=
